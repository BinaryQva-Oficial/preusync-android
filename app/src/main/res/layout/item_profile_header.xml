<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PreuSync.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/padding_8dp"
    android:layout_marginVertical="@dimen/padding_8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_16dp">

        <!-- Avatar (Izquierda) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="36dp"
            app:cardBackgroundColor="?attr/colorAccent"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Texto de inicial -->
            <TextView
                android:id="@+id/initialAvatarText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="?attr/colorBackground"
                android:visibility="gone"
                tools:text="D" />

            <!-- Imagen de rol o foto -->
            <ImageView
                android:id="@+id/roleAvatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:src="@drawable/ic_school"
                android:contentDescription="@string/hint_role" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Nombre(s) arriba y Apellidos abajo (A la derecha del Avatar) -->
        <LinearLayout
            android:id="@+id/nameContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="32dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/cardAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardAvatar"
            app:layout_constraintBottom_toBottomOf="@id/cardAvatar">

            <TextView
                android:id="@+id/firstNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorText"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Daniel Alejandro" />

            <TextView
                android:id="@+id/lastNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="15sp"
                android:textColor="?attr/colorTextHint"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Pupo González" />
        </LinearLayout>

        <!-- Ícono de Verificación (Esquina superior derecha) -->
        <ImageView
            android:id="@+id/statusImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_verified"
            app:tint="?attr/colorAccent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/label_verified" />

        <!-- Información de Rol e Identificación (Parte inferior izquierda) -->
        <LinearLayout
            android:id="@+id/leftInfoContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/locationContainer"
            app:layout_constraintTop_toBottomOf="@id/cardAvatar">

            <TextView
                android:id="@+id/usernameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorAccent"
                tools:text="JiroxDEV" />

            <TextView
                android:id="@+id/roleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="?attr/colorTextHint"
                tools:text="Estudiante" />

            <TextView
                android:id="@+id/groupText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="?attr/colorText"
                tools:text="Grupo: 12 - 2" />

            <TextView
                android:id="@+id/roleExtraInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="?attr/colorTextHint"
                android:visibility="gone"
                tools:text="Educando: @pupo" />
        </LinearLayout>

        <!-- Ubicación en la parte inferior derecha (Escuela, Municipio, Provincia) -->
        <LinearLayout
            android:id="@+id/locationContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAvatar">

            <TextView
                android:id="@+id/schoolText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textSize="12sp"
                android:textColor="?attr/colorText"
                android:drawablePadding="6dp"
                app:drawableStartCompat="@drawable/ic_school"
                app:drawableTint="?attr/colorAccent"
                tools:text="IPVCE Mártires de Humboldt" />

            <TextView
                android:id="@+id/municipalityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:textSize="12sp"
                android:textColor="?attr/colorTextHint"
                android:drawablePadding="6dp"
                app:drawableStartCompat="@drawable/ic_place"
                app:drawableTint="?attr/colorAccent"
                tools:text="Artemisa" />

            <TextView
                android:id="@+id/provinceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:textSize="12sp"
                android:textColor="?attr/colorTextHint"
                android:drawablePadding="6dp"
                app:drawableStartCompat="@drawable/ic_place"
                app:drawableTint="?attr/colorAccent"
                tools:text="Artemisa" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
